# dependencies
node_modules/

# build output
dist/
build/
.next/
out/

# env / secrets — never commit the Neon connection string or Meta tokens
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

# test artifacts
coverage/
test-results/
playwright-report/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# AIC-126: generated by scripts/build-guides.mjs from content/guides/*.md.
# The markdown IS the source; these are build output and would otherwise show
# up as spurious diffs on every build.
web/public/guides/
web/public/guides.html
web/public/sitemap.xml
web/public/robots.txt
