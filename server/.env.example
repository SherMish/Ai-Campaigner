# Env is loaded from the repo-ROOT .env (see server/src/load-env.ts), so keep one
# .env at the repo root — not in server/. Never commit it (.env is gitignored).

# Neon serverless Postgres connection string.
# Use a DEV/preview BRANCH locally and in CI — NEVER the production branch. The
# production branch URL belongs only in the Railway service variables.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# API server port
PORT=4000

# Allowed browser origin for the web client (dev default below)
CORS_ORIGIN=http://localhost:5173

# Meta / Marketing API (see docs/META_SETUP.md). Secrets live in Railway, never
# in the repo or client. Placeholders below just document the expected names.
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_GRAPH_VERSION=v21.0

# Admin/ops API guard. When unset, /api/admin is OPEN — set this before any public
# deploy (bearer token on the admin routes).
ADMIN_TOKEN=

# Customer auth (AIC-21, P0.5) = email + password. Only JWT_SECRET is needed
# (sessions are our own JWT; passwords are bcrypt-hashed — no external key).
JWT_SECRET=

# Google sign-in is deferred to AIC-30. Set this only when that ships: an OAuth 2.0
# *Web client id* (no client secret — the server verifies the Google ID token by
# audience). Leave empty for the email+password-only P0.
GOOGLE_CLIENT_ID=

# Optional: live LLM rephrasing of recommendation explanations (AIC-10/23). We use
# OpenRouter, NOT Anthropic directly. Unset = the deterministic Hebrew template
# renders (no key required).
OPENROUTER_API_KEY=
