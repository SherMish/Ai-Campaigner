# Neon serverless Postgres connection string.
# Use a DEV/preview branch locally and in CI — NEVER the production branch.
DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/aicampaigner?sslmode=require

# API server port
PORT=4000

# Allowed browser origin for the web client (dev default below)
CORS_ORIGIN=http://localhost:5173
